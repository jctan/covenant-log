---
import AdminIcon from './AdminIcon.astro';
import AdminSiteSocialSection from './AdminSiteSocialSection.astro';
import { ADMIN_OVERVIEW_HIDDEN_MESSAGE_MAX_LENGTH } from '../../lib/admin-console/theme-shared';

interface Props {
  footerStartYearMin: number;
  footerStartYearMax: number;
  socialCustomLimit: number;
}

const { footerStartYearMin, footerStartYearMax, socialCustomLimit } = Astro.props;
---

<fieldset class="admin-group">
  <legend class="admin-group__legend">
    <AdminIcon name="admin-site" class="admin-group__legend-icon" size={14} />
    <span class="admin-group__legend-copy">
      <span class="admin-group__legend-zh">Site Settings</span>
      <span class="admin-group__legend-en">Site</span>
    </span>
  </legend>
  <div class="admin-grid">
    <label class="admin-field">
      <span class="admin-label">
        <span class="admin-label__main">Site title</span>
        <span class="admin-label__hint">(used for the browser title / RSS / sharing)</span>
      </span>
      <input class="admin-field__control" id="site-title" type="text" autocomplete="off" />
    </label>
    <label class="admin-field">
      <span class="admin-label">
        <span class="admin-label__main">Site language</span>
        <span class="admin-label__hint">(defaults to en)</span>
      </span>
      <input class="admin-field__control" id="site-default-locale" type="text" autocomplete="off" />
    </label>
    <label class="admin-field admin-field--full">
      <span class="admin-label">
        <span class="admin-label__main">Default SEO description</span>
        <span class="admin-label__hint">(used for search results and share summaries)</span>
      </span>
      <textarea class="admin-field__control admin-field__control--singleline-textarea" id="site-description" rows="1"></textarea>
    </label>
    <label class="admin-field">
      <span class="admin-label">
        <span class="admin-label__main">Footer year</span>
        <span class="admin-label__hint">(the end year automatically picks up the current year)</span>
      </span>
      <span class="admin-year-range">
        <input
          class="admin-field__control"
          id="site-footer-start-year"
          type="number"
          min={footerStartYearMin}
          max={footerStartYearMax}
          step="1"
          inputmode="numeric"
          placeholder={String(footerStartYearMax)}
          aria-describedby="site-footer-preview"
        />
        <span class="admin-year-range__sep" aria-hidden="true">-</span>
        <input
          class="admin-field__control admin-year-range__readonly"
          name="site-footer-current-year-display"
          type="text"
          value={String(footerStartYearMax)}
          readonly
          tabindex="-1"
          aria-label="Current year (automatic)"
        />
        <label class="admin-year-range__toggle">
          <input id="site-footer-show-current-year" type="checkbox" checked />
          <span class="sr-only">Show current year</span>
        </label>
      </span>
    </label>
    <label class="admin-field">
      <span class="admin-label">
        <span class="admin-label__main">Footer copyright text</span>
      </span>
      <input class="admin-field__control" id="site-footer-copyright" type="text" autocomplete="off" aria-describedby="site-footer-preview" />
    </label>
    <div class="admin-field admin-field--full">
      <p id="site-footer-preview" class="admin-help">
        Footer preview: <code id="site-footer-preview-value">© {footerStartYearMax} Whono · Theme Demo · by cxro</code>
      </p>
    </div>
    <div class="admin-field admin-field--full">
      <div class="admin-label admin-label--split">
        <span class="admin-label__copy">
          <label class="admin-label__main" for="site-admin-overview-hidden-message">
            <code>/admin/</code> Overview public access (not indexed)
          </label>
          <span class="admin-label__hint">(takes effect after a build; when public access is off, this page only shows the text below)</span>
        </span>
        <label class="admin-label__toggle" for="site-admin-overview-public-visible">
          <input id="site-admin-overview-public-visible" type="checkbox" checked />
          <span>Public</span>
        </label>
      </div>
      <input
        class="admin-field__control"
        id="site-admin-overview-hidden-message"
        type="text"
        maxlength={ADMIN_OVERVIEW_HIDDEN_MESSAGE_MAX_LENGTH}
        autocomplete="off"
        disabled
      />
    </div>
    <div class="admin-field admin-field--full">
      <span class="admin-label">
        <span class="admin-label__main">Site icons</span>
        <span class="admin-label__hint">(browser tab / mobile touch icon; takes effect after a build)</span>
      </span>
      <input id="site-favicon-svg" type="hidden" />
      <input id="site-favicon-png" type="hidden" />
      <input id="site-favicon-apple-touch-icon" type="hidden" />
      <div class="admin-favicon-line">
        <div class="admin-favicon-slot" data-favicon-slot="png">
          <span class="admin-favicon-slot__preview" data-favicon-preview="png">
            <img alt="" loading="lazy" decoding="async" data-favicon-preview-img="png" />
          </span>
          <span class="admin-favicon-slot__label">Tab icon</span>
          <button class="admin-btn admin-btn--ghost admin-btn--compact" type="button" data-favicon-upload="png" aria-label="Upload tab icon">Upload</button>
          <button class="admin-btn admin-btn--ghost admin-btn--compact" type="button" data-favicon-clear="png" aria-label="Restore tab icon to the theme default">Restore default</button>
        </div>
        <span class="admin-favicon-line__divider" aria-hidden="true"></span>
        <div class="admin-favicon-slot" data-favicon-slot="appleTouchIcon">
          <span class="admin-favicon-slot__preview" data-favicon-preview="appleTouchIcon">
            <img alt="" loading="lazy" decoding="async" data-favicon-preview-img="appleTouchIcon" />
          </span>
          <span class="admin-favicon-slot__label">Touch icon</span>
          <button class="admin-btn admin-btn--ghost admin-btn--compact" type="button" data-favicon-upload="appleTouchIcon" aria-label="Upload touch icon">Upload</button>
          <button class="admin-btn admin-btn--ghost admin-btn--compact" type="button" data-favicon-clear="appleTouchIcon" aria-label="Restore touch icon to the theme default">Restore default</button>
        </div>
      </div>
      <input type="file" accept="image/png" hidden data-favicon-file="png" />
      <input type="file" accept="image/png" hidden data-favicon-file="appleTouchIcon" />
      <p class="admin-help">
        Upload a square PNG at 256x256 (16-512px, under 256KB); to change the SVG icon, replace <code>public/favicon.svg</code> directly.
      </p>
    </div>
  </div>

  <AdminSiteSocialSection socialCustomLimit={socialCustomLimit} />
</fieldset>
